<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        android:elevation="1dp"
        app:title="SO Sandbox"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <!-- 主操作按钮 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/accent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_so"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="打开 SO 文件"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconTint="@color/white"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </androidx.cardview.widget.CardView>

            <!-- 当前项目标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/accent"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前项目"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@color/divider" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- 左侧强调条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="match_parent"
                            android:background="@color/accent"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 文件名 -->
                            <TextView
                                android:id="@+id/tv_so_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <!-- 信息行 -->
                            <TextView
                                android:id="@+id/tv_base_addr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tv_func_count"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- 按钮区 - 现代 pill 风格 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <!-- 主要操作按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_functions"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="函数列表"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/accent"
                            app:cornerRadius="24dp"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                        <!-- 辅助操作行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_strings"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="字符串"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/main_open_btn_bg"
                                app:strokeColor="@color/accent_light"
                                app:strokeWidth="1dp"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_plt"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="PLT"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/main_open_btn_bg"
                                app:strokeColor="@color/accent_light"
                                app:strokeWidth="1dp"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_register_natives"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="注册表"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/main_open_btn_bg"
                                app:strokeColor="@color/accent_light"
                                app:strokeWidth="1dp"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 最近项目标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/accent_variant"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最近项目"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="清空"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@android:color/transparent"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_projects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:indeterminateTint="@color/main_accent" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/red_error"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>