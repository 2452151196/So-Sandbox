<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- 原始行信息 -->
        <TextView
            android:id="@+id/tv_original_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A4CAF50"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 点击的元素类型标签 -->
        <TextView
            android:id="@+id/tv_click_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorAccent"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 被点击的文本显示 -->
        <TextView
            android:id="@+id/tv_selected_element"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="#1A2196F3"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#2196F3"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 汇编指令输入 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="汇编指令"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_assembly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:fontFamily="monospace"
            android:hint="mov x0, x1  或  add x2, x3, #0x100"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:maxLines="3"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 原始机器码显示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="原始机器码"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_original_bytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:fontFamily="monospace"
            android:minHeight="36dp"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 新机器码预览 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="新机器码 (预览)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_new_bytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:fontFamily="monospace"
            android:minHeight="36dp"
            android:padding="10dp"
            android:textColor="@color/code_modified_insn"
            android:textSize="13sp" />

        <!-- 操作数快速编辑 -->
        <LinearLayout
            android:id="@+id/layout_quick_operands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="寄存器"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_reg_x0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_text"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="x0"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_reg_x1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_text"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="x1"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_reg_x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_text"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="x2"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_reg_x3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_text"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="x3"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="立即数"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_immediate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text"
                android:fontFamily="monospace"
                android:hint="#0x1000  或  #1024"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:minHeight="40dp"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="提示: 支持所有ARM64指令。点击地址、寄存器、立即数可快速编辑对应部分。"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
