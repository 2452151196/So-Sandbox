<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Function name -->
        <TextView
            android:id="@+id/tv_dialog_func_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cyan_500"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Address info -->
        <TextView
            android:id="@+id/tv_dialog_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Return type spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/return_type"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_ret_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_surface"
            android:layout_marginBottom="16dp" />

        <!-- Parameters section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="参数"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_param"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/add_param"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/bg_surface"
                android:textColor="@color/cyan_500"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>

        <!-- Dynamic params container -->
        <LinearLayout
            android:id="@+id/params_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Invoke button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_invoke"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/invoke_function"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:backgroundTint="@color/cyan_500"
            app:cornerRadius="8dp" />

        <!-- Result area -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_result_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_result_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_success"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
