<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Param index -->
    <TextView
        android:id="@+id/tv_param_index"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Type spinner -->
    <Spinner
        android:id="@+id/spinner_param_type"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@color/bg_surface"
        android:layout_marginEnd="8dp" />

    <!-- Value input -->
    <EditText
        android:id="@+id/et_param_value"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:hint="@string/param_value"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp"
        android:background="@color/bg_surface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:inputType="text"
        android:singleLine="true" />

    <!-- Remove button -->
    <ImageView
        android:id="@+id/btn_remove_param"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_delete"
        android:tint="@color/red_error"
        android:padding="4dp"
        android:layout_marginStart="4dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
