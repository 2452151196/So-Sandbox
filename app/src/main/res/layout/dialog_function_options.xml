<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_surface">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_func_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cyan_500"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_func_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <!-- 三个选项按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_invoke"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔧  动态调用函数"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:backgroundTint="@color/cyan_500"
        app:cornerRadius="8dp"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_disasm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📋  查看汇编代码"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:backgroundTint="@color/bg_card"
        app:cornerRadius="8dp"
        app:strokeColor="@color/cyan_500"
        app:strokeWidth="1dp"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_decompile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📝  查看伪C代码"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:backgroundTint="@color/bg_card"
        app:cornerRadius="8dp"
        app:strokeColor="#FF9800"
        app:strokeWidth="1dp"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_xrefs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔗  交叉引用 (XRef)"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:backgroundTint="@color/bg_card"
        app:cornerRadius="8dp"
        app:strokeColor="#9C27B0"
        app:strokeWidth="1dp"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
